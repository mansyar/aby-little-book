# Dependencies and build output
node_modules/
dist/
dev-dist/
.pnpm-store/

# Test and browser artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright-cli/

# Version control and automation
.git/
.github/
conductor/

# Project documents and art sources stay out of the build context,
# except the three runtime inputs src/ imports at build time
# (style bible, package manifest, GLB binaries). Negations need the
# parent rule as art/*: a file below an excluded directory cannot be
# re-included.
docs/
art/*
!art/style-bible.json
!art/manifest/
!art/glb/

# Local environment
.env
.env.*
*.log

# OS metadata
.DS_Store
Thumbs.db
